# ─── Required ─────────────────────────────────────────────────────────────
# Secret used to sign access tokens — use a long, random string in production.
JWT_SECRET_KEY=your_jwt_secret
# PostgreSQL connection string used by Prisma at runtime + for migrations.
DATABASE_URL=postgresql://user:password@localhost:5432/blog_panel
# Same connection string but reachable from inside Docker (service name "db").
DOCKER_DATABASE_URL=postgresql://user:password@db:5432/blog_panel

# ─── Server ───────────────────────────────────────────────────────────────
# Port the API listens on (default 8080).
PORT=8080
# Set to "production" in deployment (enables combined logs + CORS warning).
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API (your panel UI and
# the public portfolio that consumes the public API). Leave empty in
# development to reflect any origin.
CORS_ORIGINS=https://panel.example.com,https://www.example.com

# ─── Rate limiting (optional) ─────────────────────────────────────────────
# Global limiter window (ms) and max requests per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Uploads / body size (optional) ───────────────────────────────────────
# Max image upload size in MB (default 10).
MAX_UPLOAD_MB=10
# Max JSON request body (default 2mb) — raise if blog content gets very large.
JSON_BODY_LIMIT=2mb
